# PostgreSQL / SQLAlchemy
POSTGRES_USER=structurax
POSTGRES_PASSWORD=replace-with-a-development-password
POSTGRES_DB=structurax_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional: takes precedence over POSTGRES_* values when set.
# DATABASE_URL=postgresql+psycopg://structurax:replace-with-a-development-password@127.0.0.1:5432/structurax_dev

# Backend
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Security (placeholders only — never commit real values)
JWT_SECRET=replace-with-a-long-random-secret
AI_PROVIDER_API_KEY=

# Compiled C DSA engine
# Optional absolute path; auto-detected at dsa-engine/build/ when left empty.
DSA_ENGINE_LIBRARY_PATH=
